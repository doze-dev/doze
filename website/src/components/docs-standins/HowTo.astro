// The pages are written for doze-website; this keeps this older site building.
import { TabItem, Tabs } from "@astrojs/starlight/components";
---
<Tabs syncKey="how">
  <TabItem label="In the app"><slot name="app" /></TabItem>
  <TabItem label="In a terminal"><slot name="terminal" /></TabItem>
</Tabs>
